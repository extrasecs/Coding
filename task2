a = int(input())
if a % 2 == 0:
    print('Число четное')
else: print('Число нечетное')

if a == 0:
    print('Число - ноль')
elif a > 0 :
    print('Число положительное')
else: 
    print('Число отрицательное')

if a >= 10 and a <= 50:
    print('Число принадлежит промежутку [10 ; 50]')
else:
    print('Число не принадлежит промежутку [ 10 ; 50]')
